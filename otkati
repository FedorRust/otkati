#!/bin/sh
# Bring up the ring and the face. One word: otkati
set -eu

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname "$self")" && pwd)

bin=$root/target/release/otkati-ring
plugin=$root/face/Otkati/Files/libotkatifiles.so
build=0
if [ ! -x "$bin" ] || [ ! -f "$plugin" ]; then
    build=1
elif [ -n "$(find "$root/src" "$root/face/files" "$root/build.rs" -type f \
    \( -name '*.rs' -o -name '*.cpp' -o -name '*.h' -o -name 'build.rs' \) \
    -newer "$bin" -print -quit)" ]; then
    build=1
fi
if [ "$build" -eq 1 ]; then
    (cd "$root" && env -u CARGO_TARGET_DIR cargo build --release --offline --bin otkati-ring)
fi

config=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
mkdir -p "$config"
awk -v bin="$bin" '
    /^ExecStart=/ { print "ExecStart=\"" bin "\""; next }
    { print }
' "$root/systemd/user/otkati-ring.service" > "$config/otkati-ring.service.tmp"
mv "$config/otkati-ring.service.tmp" "$config/otkati-ring.service"
awk -v dir="$root" '
    /^WorkingDirectory=/ { print "WorkingDirectory=" dir; next }
    { print }
' "$root/systemd/user/otkati-face.service" > "$config/otkati-face.service.tmp"
mv "$config/otkati-face.service.tmp" "$config/otkati-face.service"

if [ -d "$HOME/.cargo/bin" ]; then
    ln -sfn "$root/otkati" "$HOME/.cargo/bin/otkati"
fi

data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$data/icons/hicolor/scalable/apps" "$data/applications"
cp -f "$root/face/otkati.svg" "$data/icons/hicolor/scalable/apps/otkati.svg"
cat > "$data/applications/otkati.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Otkati
Comment=Instant replay for Hyprland
Exec=$root/otkati
Icon=otkati
Terminal=false
Categories=AudioVideo;
StartupWMClass=otkati
EOF
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
fi

systemctl --user daemon-reload
systemctl --user reset-failed otkati-ring.service otkati-face.service
systemctl --user enable otkati-ring.service otkati-face.service
if [ "$build" -eq 1 ]; then
    systemctl --user restart otkati-ring.service otkati-face.service
else
    systemctl --user start otkati-ring.service otkati-face.service
fi
systemctl --user --quiet is-active otkati-ring.service
systemctl --user --quiet is-active otkati-face.service
